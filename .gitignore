*.env

# Ignore Terraform directories and files
.terraform/
terraform.tfstate
terraform.tfstate.backup

# Optionally ignore other sensitive or temporary files
.idea/                # IntelliJ IDEA project files (if using JetBrains)
*.log                  # Log files
.DS_Store              # macOS system files
